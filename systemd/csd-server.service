[Unit]
Description=CSD Server Service
After=network.target

[Service]
User=rehak
Group=ecris
WorkingDirectory=/opt/csd_server
EnvironmentFile=/etc/default/csd-server
ExecStart=/opt/csd_server/.venv/bin/gunicorn -w 4 --b 0.0.0.0:5000 'app:create_app()'
Restart=on-failure
RestartSec=5
KillMode=mixed
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
